---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import JsonLd from '../components/JsonLd.astro';
import { SITE } from '../consts';
import { personSchema } from '../utils/schema';
import type { Locale } from '../consts';

interface Props {
  title: string;
  description?: string;
  lang?: Locale;
  path: string;
  image?: string;
  type?: 'website' | 'article';
  extraJsonLd?: Record<string, unknown>[];
}

const {
  title,
  description = SITE.description,
  lang = 'zh',
  path,
  image,
  type = 'website',
  extraJsonLd = [],
} = Astro.props;

const canonicalURL = new URL(path, SITE.url).toString();
const ogImage = image ? new URL(image, SITE.url).toString() : new URL('/og-default.svg', SITE.url).toString();
const ogLocale = lang === 'zh' ? 'zh_CN' : lang === 'fr' ? 'fr_FR' : 'en_US';
const pageTitle = path === '/' || path === '' ? `${title}` : `${title} | ${SITE.title}`;

const jsonLdBlocks = [personSchema(), ...extraJsonLd];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:locale" content={ogLocale} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {jsonLdBlocks.map((block) => <JsonLd data={block} />)}
  </head>
  <body>
    <Header lang={lang} />
    <main class="wrap">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
