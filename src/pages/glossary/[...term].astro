---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations, localizePath } from '../../i18n/ui';
import { definedTermSchema } from '../../utils/schema';
import { SITE } from '../../consts';

export async function getStaticPaths() {
  const entries = await getCollection('glossary', ({ data }) => !data.draft && data.lang === 'zh');
  return entries.map((entry) => ({ params: { term: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const t = useTranslations('zh');
const path = `/glossary/${entry.id}/`;
const url = new URL(path, SITE.url).toString();

const schema = definedTermSchema({
  term: entry.data.title,
  description: entry.data.description,
  url,
  lang: 'zh',
});
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  lang="zh"
  path={path}
  extraJsonLd={[schema]}
>
  <article class="prose">
    <h1>{entry.data.title}</h1>
    <Content />
    <p><a href={localizePath('/glossary/', 'zh')}>&larr; {t('article.backToList')}</a></p>
  </article>
</BaseLayout>
