---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleList from '../../components/ArticleList.astro';
import { useTranslations } from '../../i18n/ui';

const t = useTranslations('zh');
const entries = (
  await getCollection('courses', ({ data }) => !data.draft && data.lang === 'zh')
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title={t('nav.courses')} description="勃艮第葡萄酒课程" lang="zh" path="/courses/">
  <h1>{t('nav.courses')}</h1>
  <ArticleList entries={entries} basePath="/courses/" lang="zh" />
</BaseLayout>
