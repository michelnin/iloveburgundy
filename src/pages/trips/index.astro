---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleList from '../../components/ArticleList.astro';
import { useTranslations } from '../../i18n/ui';

const t = useTranslations('zh');
const entries = (await getCollection('trips', ({ data }) => !data.draft && data.lang === 'zh')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<BaseLayout title={t('nav.trips')} description="勃艮第游学旅行" lang="zh" path="/trips/">
  <h1>{t('nav.trips')}</h1>
  <ArticleList entries={entries} basePath="/trips/" lang="zh" />
</BaseLayout>
